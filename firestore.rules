rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is operating on their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check admin role safely
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'ADMIN' || 
        request.auth.token.role == 'SUPER_ADMIN' ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'srics2425@gmail.com' ||
          request.auth.token.email == 'admin@sctech.com' ||
          request.auth.token.email == 'superadmin@sctech.com'
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN'))
      );
    }

    // Students collection (Canonical student profile collection)
    match /students/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Users collection
    match /users/{userId} {
      allow read, create, update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Public catalog collections: companies, internships, hackathons, plans, courses
    match /companies/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /internships/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Projects & Project Workspaces
    match /projects/{id} {
      allow read: if (isAuthenticated() && (resource.data.ownerId == request.auth.uid || (resource.data.memberIds != null && request.auth.uid in resource.data.memberIds) || isAdmin())) ||
                     (resource.data.submissionStatus in ['SUBMITTED', 'UNDER_REVIEW', 'SHORTLISTED', 'WINNER', 'PUBLISHED']) ||
                     (resource.data.status == 'PUBLISHED');
      allow create: if isAuthenticated() && (request.resource.data.ownerId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || (resource.data.memberIds != null && request.auth.uid in resource.data.memberIds) || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /projectWorkspaces/{id} {
      allow read: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || resource.data.userId == request.auth.uid || (resource.data.memberIds != null && request.auth.uid in resource.data.memberIds) || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.ownerId == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());
    }

    match /hackathons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /courses/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /courseModules/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /courseLessons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /plans/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /problemStatements/{id} {
      allow read: if (resource.data.status == 'PUBLISHED' && (resource.data.scheduledReleaseAt == null || resource.data.scheduledReleaseAt <= request.time.toMillis() || resource.data.scheduledReleaseAt <= request.time)) || isAdmin();
      allow write: if isAdmin();
    }

    match /savedProblems/{id} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /problemTeams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.leaderId == request.auth.uid || (request.resource.data.memberIds != null && request.auth.uid in request.resource.data.memberIds) || isAdmin());
      allow update: if isAuthenticated() && (resource.data.leaderId == request.auth.uid || (resource.data.memberIds != null && request.auth.uid in resource.data.memberIds) || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.leaderId == request.auth.uid || isAdmin());
    }

    match /evaluations/{evalId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /opportunities/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /submissions/{subId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Internship Applications
    match /internshipApplications/{appId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Hackathon Registrations & Submissions
    match /hackathonTeams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() || isAdmin();
      allow delete: if isAdmin();
    }

    match /hackathonRegistrations/{regId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow write: if isAdmin();
    }

    match /hackathonSubmissions/{subId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.studentId == request.auth.uid;
      allow write: if isAdmin();
    }

    // Certificates
    match /certificates/{certId} {
      allow read: if true; // Verifiable certificates
      allow write: if isAdmin();
    }

    // Feedback
    match /feedback/{feedbackId} {
      allow create: if true; // Anonymous or student submission
      allow read, update, delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read, update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Subscriptions
    match /subscriptions/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // SC Idea Link: Ideas & Connections
    match /scIdeaLinkIdeas/{ideaId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
    }

    match /scIdeaLinkConnections/{connId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Project Enrollments, Purchases & Tasks
    match /projectPurchases/{purchaseId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /projectEnrollments/{enrId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
    }

    match /projectTasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /userProjectTasks/{taskId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || request.resource.data.studentId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.studentId == request.auth.uid || isAdmin());
    }

    // Discovered Catalogs
    match /discoveredInternships/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /discoveredCourses/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hackathonResults/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Support Tickets & Audit Logs
    match /supportTickets/{ticketId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /adminAiGenerations/{genId} {
      allow read, write: if isAdmin();
    }

    // Site Settings (Homepage Featured Opportunities, Platform Configurations)
    match /siteSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
