rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // User profile pictures
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Student Resumes
    match /resumes/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (
        request.auth.uid == userId || 
        request.auth.token.role == 'ADMIN' || 
        request.auth.token.role == 'SUPER_ADMIN'
      );
      allow create, update: if request.auth != null && request.auth.uid == userId
                   && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if request.auth != null && (
        request.auth.uid == userId || 
        request.auth.token.role == 'ADMIN' || 
        request.auth.token.role == 'SUPER_ADMIN'
      );
    }

    // Hackathon Submissions
    match /hackathons/{hackathonId}/submissions/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024;
    }

    // Verified Digital Certificates
    match /certificates/{certificateId}.pdf {
      allow read: if true;
      allow write: if false; // Only written by secure Cloud Function / Admin
    }

    // Project Source Code Archives (Protected)
    match /projects/{projectId}/source/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false; // Admin only
    }
  }
}
